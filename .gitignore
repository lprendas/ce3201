# Toolchain / editor noise
.vscode/
.DS_Store
*.swp
*.swo
*~

# Python test and cache artefacts
__pycache__/
.pytest_cache/
*.py[cod]
*.log
.coverage
coverage/

# Verilator / cocotb generated files
obj_dir/
sim_build/
results.xml

# Quartus / FPGA tooling artefacts
# Keep the actual project-definition/source files, but ignore generated build outputs.
quartus/*
!quartus/*.qpf
!quartus/*.qsf
!quartus/*.sv
!quartus/*.svh
!quartus/*.v
!quartus/*.tcl
quartus/db/
quartus/incremental_db/
quartus/output_files/
quartus/*.qws
quartus/*.rpt
quartus/*.sof
quartus/*.pof
quartus/*.bak
quartus/*.orig
quartus/*.rej

# Keep intentional local synthesis reports and repo marker
output_files/*
!output_files/.gitkeep
!output_files/*.rpt
